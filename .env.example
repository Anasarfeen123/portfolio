# Contact form (src/app/api/contact/route.ts) — sends email via Resend (https://resend.com).
# Without RESEND_API_KEY set, the form fails gracefully and the UI points people at the
# mailto: link instead. To enable it:
#   1. Sign up at resend.com and create an API key.
#   2. Set these in your local .env.local and in your Vercel project's Environment Variables.

RESEND_API_KEY=
# Where contact-form messages get delivered. Defaults to codecrusader07@gmail.com if unset.
CONTACT_TO_EMAIL=codecrusader07@gmail.com
# Must be a verified sending domain in Resend, or their shared onboarding@resend.dev for testing.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Admin (src/app/admin, gated by src/proxy.ts + src/auth.ts) — a git-backed blog
# CMS restricted to one GitHub account (ADMIN_GITHUB_LOGIN in src/lib/admin.ts) via
# "Sign in with GitHub". Publishing = an immediate commit to content/blog/ on main,
# which the site is already set up to auto-deploy. To enable it:
#
# 1. Create TWO GitHub OAuth Apps at https://github.com/settings/developers → "New OAuth App"
#    (two are needed because a GitHub OAuth App only supports one callback URL):
#      - "Portfolio Admin (Production)"
#          Homepage URL:            https://anasarfeen.dev
#          Authorization callback:  https://anasarfeen.dev/api/auth/callback/github
#      - "Portfolio Admin (Local Dev)"
#          Homepage URL:            http://localhost:3000
#          Authorization callback:  http://localhost:3000/api/auth/callback/github
#    For each, generate a client secret and copy the Client ID + Secret.
#
# 2. Generate AUTH_SECRET (run once): npx auth secret
#    — or manually: openssl rand -base64 33
#
# 3. Create a fine-grained Personal Access Token for writing blog content, separate
#    from the login above, at https://github.com/settings/personal-access-tokens/new:
#      Resource owner:        Anasarfeen123
#      Repository access:     Only select repositories → portfolio
#      Permissions:           Repository permissions → Contents → Read and write
#                              (leave every other permission at "No access")
#      Expiration:            set one (e.g. 90 days) and put a reminder to rotate it
#
# 4. Set env vars:
#      .env.local        → use the "Local Dev" OAuth App's ID/secret
#      Vercel dashboard   → use the "Production" OAuth App's ID/secret
#                           (Project Settings → Environment Variables, Production + Preview)
#    Both places also need AUTH_SECRET and GITHUB_CONTENT_TOKEN.
#    (AUTH_URL is not needed — Auth.js auto-detects the deployment URL on Vercel.)

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
GITHUB_CONTENT_TOKEN=
# Optional overrides — defaults already point at Anasarfeen123/portfolio on main.
# Point GITHUB_CONTENT_BRANCH at a scratch branch while first testing publish/delete,
# then switch it to main once verified.
GITHUB_CONTENT_OWNER=Anasarfeen123
GITHUB_CONTENT_REPO=portfolio
GITHUB_CONTENT_BRANCH=main

# Analytics dashboard (/admin/analytics) — queries Vercel's Web Analytics API
# directly (works on the free Hobby plan; 1-month reporting window, vs 12 on
# Pro). Without these set, the page fails closed with a clear "not
# configured" message rather than showing empty charts as if they were real
# zero-traffic data. To enable it:
#
# 1. Create a token at https://vercel.com/account/tokens — scope it to this
#    project's team if the dashboard lets you narrow it, since it can read
#    analytics for whatever it's scoped to.
# 2. Find your project id: Vercel dashboard → this project → Settings →
#    General → "Project ID".
# 3. Only if this project lives under a Vercel Team (not your personal
#    account): also grab the Team ID from Team Settings → General.

VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
