# Contact form (src/app/api/contact/route.ts) — sends email via Resend (https://resend.com).
# Without RESEND_API_KEY set, the form fails gracefully and the UI points people at the
# mailto: link instead. To enable it:
#   1. Sign up at resend.com and create an API key.
#   2. Set these in your local .env.local and in your Vercel project's Environment Variables.

RESEND_API_KEY=
# Where contact-form messages get delivered. Defaults to codecrusader07@gmail.com if unset.
CONTACT_TO_EMAIL=codecrusader07@gmail.com
# Must be a verified sending domain in Resend, or their shared onboarding@resend.dev for testing.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
